<!-- Material Temperature Settings Overlay -->
<!-- Two-view overlay: scrollable material list → edit form for a selected material -->
<component>
  <styles>
    <style name="profile_temp_landscape" width="23%" flex_grow="1"/>
    <style name="profile_temp_portrait" width="47%" flex_grow="0"/>
  </styles>
  <view name="material_temps_overlay"
        extends="overlay_panel" title="Material Temperatures" bg_color="#screen_bg" title_font="#font_body">
    <!-- Content Area -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_bottom="#space_lg" scrollable="false" flex_flow="column">
      <!-- Column header (fixed, doesn't scroll) -->
      <lv_obj name="material_list_header"
              width="100%" height="content" scrollable="false" flex_flow="row" style_pad_left="#space_sm"
              style_pad_right="#space_sm" style_margin_right="#space_md" style_pad_top="#space_sm"
              style_pad_bottom="#space_xs" style_pad_gap="0">
        <bind_flag_if_not_eq subject="material_editing" flag="hidden" ref_value="0"/>
        <text_muted text="Material" flex_grow="1"/>
        <text_muted text="Nozzle / Bed"/>
      </lv_obj>
      <ui_button name="btn_add_profile" width="100%" text="Add Profile" icon="plus">
        <bind_flag_if_not_eq subject="material_editing" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_material_add_profile"/>
      </ui_button>
      <divider_horizontal name="material_list_divider">
        <bind_flag_if_not_eq subject="material_editing" flag="hidden" ref_value="0"/>
      </divider_horizontal>
      <!-- ================================================================== -->
      <!-- LIST VIEW (shown when not editing) -->
      <!-- ================================================================== -->
      <!-- pad_right keeps the scrollbar off the right-aligned values; the
           header's matching margin keeps its column labels over them. -->
      <lv_obj name="material_list_view"
              width="100%" flex_grow="1" scrollable="true" flex_flow="column" style_pad_all="0"
              style_pad_right="#space_md" style_pad_gap="0">
        <bind_flag_if_not_eq subject="material_editing" flag="hidden" ref_value="0"/>
        <!-- Populated programmatically with material rows -->
      </lv_obj>
      <!-- ================================================================== -->
      <!-- EDIT VIEW (shown when editing a material) -->
      <!-- ================================================================== -->
      <lv_obj name="material_edit_view"
              width="100%" flex_grow="1" scrollable="true" flex_flow="column" style_pad_all="0">
        <bind_flag_if_eq subject="material_editing" flag="hidden" ref_value="0"/>
        <lv_obj name="profile_name_row"
                width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs"
                scrollable="false">
          <bind_flag_if_eq subject="material_edit_is_shipped" flag="hidden" ref_value="1"/>
          <text_body text="Profile Name"/>
          <text_input name="edit_profile_name" width="100%" max_length="63"/>
        </lv_obj>
        <!-- Give the title its own full-width line. Shipped defaults follow
             below it; a custom profile has no separate defaults to restore. -->
        <lv_obj name="material_identity"
                width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_bottom="#space_lg"
                style_pad_gap="#space_xs" scrollable="false" style_flex_cross_place="start">
          <text_heading name="edit_material_name"
                        width="100%" bind_text="material_edit_name" long_mode="dots" max_lines="1"/>
          <text_small name="edit_defaults_hint"
                      width="100%" bind_text="material_edit_defaults" style_text_color="#text_muted">
            <bind_flag_if_eq subject="material_edit_is_shipped" flag="hidden" ref_value="0"/>
          </text_small>
        </lv_obj>
        <!-- Nozzle Min / Nozzle Max / Bed Temp / Chamber Temp (four-column row).
             Each input fills its own column (flex_grow="1") up to a 120px cap,
             so the row shrinks on a narrow screen but never grows past its
             standard size on a wide one; ui_xml/micro/ and ui_xml/micro_portrait/
             still reflow it to two-by-two for the two tiers too short to hold
             one row at all. -->
        <lv_obj width="100%" flex_flow="row_wrap" style_pad_all="0" style_pad_gap="#space_sm" scrollable="false">
          <!-- Nozzle Min column -->
          <lv_obj flex_flow="column" style_pad_all="0" scrollable="false">
            <bind_style_if_eq name="profile_temp_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="profile_temp_portrait" subject="ui_is_portrait" ref_value="1"/>
            <text_body width="100%" style_pad_bottom="#space_xs" text="Nozzle Min (°C)"/>
            <text_input name="edit_nozzle_min" width="100%" style_max_width="120" keyboard_hint="numeric" max_length="4"/>
          </lv_obj>
          <!-- Nozzle Max column -->
          <lv_obj flex_flow="column" style_pad_all="0" scrollable="false">
            <bind_style_if_eq name="profile_temp_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="profile_temp_portrait" subject="ui_is_portrait" ref_value="1"/>
            <text_body width="100%" style_pad_bottom="#space_xs" text="Nozzle Max (°C)"/>
            <text_input name="edit_nozzle_max" width="100%" style_max_width="120" keyboard_hint="numeric" max_length="4"/>
          </lv_obj>
          <!-- Bed Temp column -->
          <lv_obj flex_flow="column" style_pad_all="0" scrollable="false">
            <bind_style_if_eq name="profile_temp_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="profile_temp_portrait" subject="ui_is_portrait" ref_value="1"/>
            <text_body width="100%" style_pad_bottom="#space_xs" text="Bed (°C)"/>
            <text_input name="edit_bed_temp" width="100%" style_max_width="120" keyboard_hint="numeric" max_length="4"/>
          </lv_obj>
          <!-- Always editable portable profile data; apply only with a supported chamber route. -->
          <lv_obj flex_flow="column" style_pad_all="0" scrollable="false">
            <bind_style_if_eq name="profile_temp_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="profile_temp_portrait" subject="ui_is_portrait" ref_value="1"/>
            <text_body width="100%" style_pad_bottom="#space_xs" text="Chamber (°C)"/>
            <text_input name="edit_chamber_temp"
                        width="100%" style_max_width="120" keyboard_hint="numeric" max_length="4"/>
          </lv_obj>
        </lv_obj>
        <!-- Flex spacer pushes buttons to bottom -->
        <lv_obj width="1" flex_grow="1" scrollable="false" style_pad_all="0"/>
        <!-- Button row -->
        <lv_obj width="100%" flex_flow="row" style_pad_all="0" style_pad_gap="#space_md" scrollable="false">
          <ui_button name="btn_reset_defaults"
                     width="0" variant="secondary" text="Reset to Default" style_pad_hor="#space_xs"
                     style_text_font="#font_small" long_mode="wrap" flex_grow="1">
            <bind_flag_if_eq subject="material_edit_is_shipped" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_material_reset_defaults"/>
          </ui_button>
          <ui_button name="btn_save_material"
                     width="0" variant="primary" text="Save" style_pad_hor="#space_xs" style_text_font="#font_small"
                     long_mode="wrap" flex_grow="1">
            <event_cb trigger="clicked" callback="on_material_save"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
