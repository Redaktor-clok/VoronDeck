      <style name="nav_button_selected" selector="checked"/>
      <bind_state_if_eq subject="active_panel" state="checked" ref_value="2"/>
      <bind_style_if_eq name="nav_button_portrait" subject="ui_is_portrait" ref_value="1"/>
      <bind_style_if_not_eq name="nav_button_landscape" subject="ui_is_portrait" ref_value="1"/>
