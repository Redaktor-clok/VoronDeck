               height="100%" flex_grow="1" variant="ghost" flex_flow="column" style_flex_main_place="center"
               style_flex_cross_place="center" style_border_width="1" style_pad_all="0" style_pad_row="#space_xxs">
      <style name="nav_button_frame"/>
      <style name="nav_button_selected" selector="checked"/>
