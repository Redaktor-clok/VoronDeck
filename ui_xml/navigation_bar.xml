                  event_bubble="true">
        <event_cb trigger="size_changed" callback="on_nav_labels_layout"/>
        <event_cb trigger="refresh" callback="on_nav_labels_layout"/>
      </text_small>
    </ui_button>
    <ui_button name="nav_btn_print_select"
