<component>
  <consts>
    <str name="step_title" value="Printer Appearance" value_tag="Printer Appearance"/>
    <str name="step_subtitle"
         value="Choose an image and theme for your screen" value_tag="Choose an image and theme for your screen"/>
  </consts>
  <view name="wizard_appearance_root"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_bg_opa="0" style_border_width="0"
        flex_flow="column" scrollable="true">
    <ui_card width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="#space_md">
      <lv_image name="wizard_printer_preview"
                width="100" height="110" inner_align="contain" bind_src="wizard_appearance_image"/>
      <text_heading name="wizard_printer_name"
                    width="0" flex_grow="1" bind_text="wizard_appearance_name" long_mode="wrap"/>
    </ui_card>
    <ui_card width="100%" height="content" style_pad_all="0" flex_flow="column">
      <setting_action_row name="wizard_choose_image" label="Printer Image" icon="printer_3d" callback="on_wizard_image"/>
      <setting_action_row name="wizard_choose_theme" label="Appearance" icon="palette" callback="on_wizard_theme"/>
      <setting_action_row name="wizard_choose_name" label="Printer Name" icon="pencil" callback="on_wizard_name"/>
    </ui_card>
  </view>
</component>
