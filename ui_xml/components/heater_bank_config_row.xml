<component>
  <api>
    <prop name="index" type="string" default="0"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_ver="#space_sm"
        style_pad_gap="#space_md" scrollable="false">
    <text_body name="heater_name" width="0" bind_text="heater_bank_cfg_${index}_name" flex_grow="1" long_mode="wrap"/>
    <!-- SIZE_OK: native graph configuration switch dimensions -->
    <lv_switch name="heater_enabled_${index}" width="44" height="24">
      <bind_state_if_eq subject="heater_bank_cfg_${index}_on" state="checked" ref_value="1"/>
      <event_cb trigger="value_changed" callback="heater_bank_switch_cb" user_data="$index"/>
    </lv_switch>
  </view>
</component>
