<component>
  <api>
    <prop name="home_visible_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_fan_carousel"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="#space_xxs" scrollable="false">
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
    <ui_carousel name="fan_carousel" width="100%" height="100%" wrap="true" show_indicators="true">
      <bind_flag_if_eq subject="$home_visible_subject" flag="hidden" ref_value="0"/>
    </ui_carousel>
    <text_small name="fan_hidden_placeholder" text="Fans hidden" align="center" width="100%" long_mode="wrap" hidden="true"
                style_text_align="center" style_text_color="#text_muted" clickable="false" event_bubble="true">
      <bind_flag_if_not_eq subject="$home_visible_subject" flag="hidden" ref_value="0"/>
    </text_small>
  </view>
</component>
