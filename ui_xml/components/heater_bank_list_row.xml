<component>
  <api><prop name="index" type="string" default="0"/></api>
  <view name="heater_bank_device_${index}" extends="lv_obj" width="100%" height="100%" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xxs" style_flex_cross_place="center" style_border_width="1" style_border_side="bottom" style_border_color="#border" scrollable="false" clickable="true" event_bubble="false">
    <event_cb trigger="clicked" callback="heater_bank_device_cb" user_data="$index"/>
    <lv_obj name="heater_bank_icon_slot" width="content" height="content" flex_flow="row" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
    <home_nozzle_icon style_text_align="center" size="md" target_subject="heater_bank_${index}_target" badge_subject="">
      <bind_flag_if_not_eq subject="heater_bank_${index}_nozzle" flag="hidden" ref_value="1"/>
    </home_nozzle_icon>
    <home_bed_icon style_text_align="center" size="md" target_subject="heater_bank_${index}_target">
      <bind_flag_if_not_eq subject="heater_bank_${index}_nozzle" flag="hidden" ref_value="2"/>
    </home_bed_icon>
    <icon style_text_align="center" name="chamber_icon_glyph" src="fire" size="md" variant="muted" clickable="false" event_bubble="true">
      
      <bind_flag_if_not_eq subject="heater_bank_${index}_nozzle" flag="hidden" ref_value="0"/>
    </icon>
    </lv_obj>
    <text_small name="heater_bank_name" bind_text="heater_bank_${index}_name" width="0" flex_grow="1" long_mode="scroll" clickable="false" event_bubble="true"/>
    <text_heading name="heater_bank_value" bind_text="heater_bank_${index}_value" clickable="false" event_bubble="true"/>
    <text_small name="heater_bank_status" bind_text="heater_bank_${index}_status" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
    <text_tiny name="heater_bank_power" bind_text="heater_bank_${index}_power" style_text_color="#text_muted" clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="heater_bank_${index}_target" flag="hidden" ref_value="0"/>
    </text_tiny>
  </view>
</component>
