<component>
  <api>
    <prop name="prefix" type="string" default="home_sensor_bank_sensor"/>
  </api>
  <view name="panel_widget_home_sensor_bank"
        extends="lv_obj" width="100%" height="100%" flex_flow="row_wrap" style_pad_all="0" style_pad_top="#space_xxs"
        style_pad_column="0" style_pad_row="#space_xxs" style_border_width="1" style_border_side="top"
        style_border_color="#border" style_border_opa="255" style_flex_main_place="start"
        style_flex_cross_place="center" style_flex_track_place="start" scrollable="true">
    <repeat count="home_sensor_bank_sensor_count">
      <home_sensor_bank_row prefix="$prefix" index="${i}"/>
    </repeat>
  </view>
</component>
