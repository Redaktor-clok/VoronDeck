<component>
  <view name="panel_widget_heater_bank_list"
        extends="lv_obj" width="100%" height="100%" flex_flow="column" style_pad_all="#space_xs" style_pad_gap="0"
        scrollable="false">
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
    <lv_obj name="heater_bank_cells"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xs" scrollbar_mode="auto"
            scrollable="true">
      <repeat count="heater_bank_count">
        <heater_bank_list_row index="${i}"/>
      </repeat>
    </lv_obj>
  </view>
</component>
